# Never put a real token in this file. Supply it only in the server environment.
# TELEGRAM_BOT_TOKEN=
RELAY_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DATABASE=./data/relay.sqlite
# Required by npm start for a persistent database: generate once, keep in secret environment.
# Canonical base64url of 32 random bytes; never put the actual production key in this file.
# RELAY_COMMAND_PAYLOAD_KEY=
RELAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4174,http://127.0.0.1:4174
# For local fixtures only. Disable before exposing through a tunnel.
RELAY_DEV_FIXTURE=0
# Public username, without @, returned to the PC for startapp links.
TELEGRAM_BOT_USERNAME=kuzmich_test_bot
